DATABASE_URL=postgresql://heban:heban_dev_password@localhost:5432/heban?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=3000
WECHAT_APP_ID=replace-with-wechat-app-id
# Fill this only in local/server deployment environments. Never commit the real secret.
WECHAT_APP_SECRET=replace-with-wechat-platform-secret
AUTH_TOKEN_SECRET=replace-with-a-long-random-server-secret

# The Mini Program public API URL belongs in apps/mini/.env.local or the build environment.
# Do not place Tencent, Azure, database, or AI credentials in apps/mini.
# VITE_MINI_API_BASE_URL=https://api.example.com/api/v1

# Food recognition stays on the local mock provider until the server-side
# CloudBase storage and Hunyuan adapters are deployed. Never copy these values
# into the mini-program or commit real credentials.
# FOOD_RECOGNITION_STORAGE_PROVIDER=mock
# FOOD_RECOGNITION_VISION_PROVIDER=mock
# CLOUDBASE_ENV_ID=
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=
# Growth plan text/vision access uses the CloudBase Node SDK when all three
# server-only values above are present. The Gateway variables below are for
# an API key created in the CloudBase AI console, not a provider key from GLM.
CLOUDBASE_AI_BASE_URL=https://your-env.api.tcloudbasegateway.com/v1/ai/cloudbase
# Keep this key on the API server only. Never copy it into apps/mini.
# CLOUDBASE_AI_API_KEY=
# CLOUDBASE_AI_TEXT_MODEL=hy3
# CLOUDBASE_AI_VISION_MODEL=glm-4v-flash
# A GLM provider key uses the direct OpenAI-compatible endpoint by default.
# CLOUDBASE_AI_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# CLOUDBASE_AI_VISION_API_KEY=
