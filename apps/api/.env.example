DATABASE_URL=postgresql://heban:heban_dev_password@localhost:5432/heban?schema=public
API_PORT=3000
MINI_API_BASE_URL=http://localhost:3000/api/v1
WECHAT_APP_ID=wxba6b329bc279b80f
# Never commit the real secret. Copy this file to .env and fill it locally.
WECHAT_APP_SECRET=replace-with-wechat-platform-secret
AUTH_TOKEN_SECRET=replace-with-a-long-random-server-secret
CLOUDBASE_AI_BASE_URL=https://your-env.api.tcloudbasegateway.com/v1/ai/cloudbase
# For the Growth Plan Node SDK path, set CLOUDBASE_ENV_ID plus
# TENCENTCLOUD_SECRET_ID and TENCENTCLOUD_SECRET_KEY instead of a Gateway key.
CLOUDBASE_AI_API_KEY=replace-with-cloudbase-ai-api-key
# Vision recognition can use a separate CloudBase Gateway provider/key.
# CLOUDBASE_AI_VISION_BASE_URL=https://your-env.api.tcloudbasegateway.com/v1/ai/cloudbase
# CLOUDBASE_AI_VISION_API_KEY=replace-with-cloudbase-vision-gateway-key
# For a GLM provider key, use the direct endpoint instead:
# CLOUDBASE_AI_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# CLOUDBASE_AI_VISION_API_KEY=replace-with-glm-provider-key
CLOUDBASE_AI_TEXT_MODEL=hy3
CLOUDBASE_AI_VISION_MODEL=glm-4v-flash
