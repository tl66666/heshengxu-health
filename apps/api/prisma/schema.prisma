generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  externalIdentities   ExternalIdentity[]
  consents             Consent[]
  healthProfile        HealthProfile?
  aiTraces             AiTrace[]
  healthTargets        HealthTarget[]
  personalPlans        PersonalPlan[]
  weightRecords        WeightRecord[]
  mealStructureRecords MealStructureRecord[]
  activityRecords      ActivityRecord[]
  sleepRecords         SleepRecord[]
  mealEntries          MealEntry[]
  userFoods            UserFood[]
  foodRecognitionUploads FoodRecognitionUpload[]
  foodRecognitionJobs  FoodRecognitionJob[]
}

model FoodCategory {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  items     FoodItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([isActive, sortOrder])
}

model FoodItem {
  id            String          @id @default(cuid())
  name          String
  brand         String?
  categoryId    String?
  isActive      Boolean         @default(true)
  pinyinCode    String?         // 拼音编码，用于搜索
  thumbImageUrl String?         // 缩略图
  isLiquid      Boolean         @default(false) // 是否流食
  healthLight   Int             @default(0) // 健康灯：0未知 1绿 2黄 3红
  category      FoodCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  aliases       FoodAlias[]
  nutrition     FoodNutrition?
  servings      FoodServing[]
  mealEntries   MealEntry[]
  recognitionCandidates FoodRecognitionCandidate[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([isActive, name])
  @@index([categoryId, isActive])
  @@index([pinyinCode])
}

model FoodAlias {
  id        String   @id @default(cuid())
  foodId    String
  alias     String
  food      FoodItem @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([foodId, alias])
  @@index([alias])
}

model FoodNutrition {
  id              String   @id @default(cuid())
  foodId          String   @unique
  basisGrams      Int      @default(100)
  energyKcal      Float
  proteinG        Float
  fatG            Float
  carbohydrateG   Float
  dietaryFiberG   Float?
  sodiumMg        Float?
  // 维生素
  vitaminAUg      Float?   // 维生素A (μg)
  thiamineMg      Float?   // 维生素B1 (mg)
  riboflavinMg    Float?   // 维生素B2 (mg)
  vitaminB6Mg     Float?   // 维生素B6 (mg)
  vitaminCMg      Float?   // 维生素C (mg)
  vitaminEMg      Float?   // 维生素E (mg)
  niacinMg        Float?   // 烟酸 (mg)
  folateMcg       Float?   // 叶酸 (μg)
  // 矿物质
  calciumMg       Float?   // 钙 (mg)
  ironMg          Float?   // 铁 (mg)
  potassiumMg     Float?   // 钾 (mg)
  zincMg          Float?   // 锌 (mg)
  seleniumUg      Float?   // 硒 (μg)
  magnesiumMg     Float?   // 镁 (mg)
  copperMg        Float?   // 铜 (mg)
  manganeseMg     Float?   // 锰 (mg)
  phosphorusMg    Float?   // 磷 (mg)
  // 其他
  cholesterolMg   Float?   // 胆固醇 (mg)
  saturatedFatG   Float?   // 饱和脂肪 (g)
  sugarG          Float?   // 糖 (g)
  gi              Float?   // 升糖指数
  gl              Float?   // 升糖负荷
  food            FoodItem @relation(fields: [foodId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FoodServing {
  id        String   @id @default(cuid())
  foodId    String
  label     String
  grams     Float
  food      FoodItem @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([foodId, label])
  @@index([foodId])
}

model MealEntry {
  id                    String    @id @default(cuid())
  userId                String
  mealType              MealType
  foodId                String?
  foodNameSnapshot      String
  grams                 Float
  energyKcal            Float
  proteinG              Float
  fatG                  Float
  carbohydrateG         Float
  dietaryFiberG         Float?
  sodiumMg              Float?
  source                MealEntrySource @default(manual)
  recordedAt            DateTime
  note                  String?
  isCurrent             Boolean   @default(true)
  previousRecordId      String?
  supersededAt          DateTime?
  deletedAt             DateTime?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  food                  FoodItem? @relation(fields: [foodId], references: [id], onDelete: SetNull)
  previousRecord        MealEntry? @relation("MealEntryVersions", fields: [previousRecordId], references: [id])
  replacements          MealEntry[] @relation("MealEntryVersions")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId, isCurrent, recordedAt])
  @@index([userId, mealType, isCurrent, recordedAt])
}

model UserFood {
  id                    String   @id @default(cuid())
  userId                String
  name                  String
  imageUrl              String?
  source                String
  energyKcal            Float
  proteinG              Float
  fatG                  Float
  carbohydrateG         Float
  defaultServingLabel   String
  defaultServingGrams   Float
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, name])
  @@index([userId, createdAt])
}

model FoodRecognitionJob {
  id           String                    @id @default(cuid())
  userId       String
  imageKey     String
  uploadId     String?
  status       FoodRecognitionJobStatus  @default(queued)
  errorCode    String?
  errorMessage String?
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  upload       FoodRecognitionUpload?    @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  candidates   FoodRecognitionCandidate[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([uploadId])
}

model FoodRecognitionUpload {
  id          String                        @id @default(cuid())
  userId      String
  objectKey   String                        @unique
  contentType String
  sizeBytes   Int
  status      FoodRecognitionUploadStatus  @default(pending)
  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  user        User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs        FoodRecognitionJob[]

  @@index([userId, status, expiresAt])
}

model FoodRecognitionCandidate {
  id             String             @id @default(cuid())
  jobId          String
  foodId         String?
  nameSnapshot   String
  confidence     Float
  estimatedGrams Float
  rank           Int
  job            FoodRecognitionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  food           FoodItem?          @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@unique([jobId, rank])
  @@index([jobId])
}

model ExternalIdentity {
  id             String           @id @default(cuid())
  userId         String
  provider       IdentityProvider
  providerUserId String
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Consent {
  id              String   @id @default(cuid())
  userId          String
  documentVersion String
  consentedAt     DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model HealthProfile {
  id          String      @id @default(cuid())
  userId      String      @unique
  displayName String?
  birthDate   DateTime?   @db.Date
  sex         ProfileSex  @default(unspecified)
  heightCm    Float?
  weightKg    Float?
  primaryGoal HealthGoal?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiTrace {
  id             String           @id @default(cuid())
  userId         String
  requestHash    String
  safetyDecision AiSafetyDecision
  safetyReason   String?
  provider       String?
  model          String?
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model HealthTarget {
  id             String           @id @default(cuid())
  userId         String
  kind           PlanKind
  direction      WeightDirection?
  targetWeightKg Float?
  startDate      DateTime         @db.Date
  status         PlanStatus       @default(active)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           PersonalPlan?

  @@index([userId, status])
}

model PersonalPlan {
  id             String       @id @default(cuid())
  userId         String
  healthTargetId String       @unique
  kind           PlanKind
  startDate      DateTime     @db.Date
  status         PlanStatus   @default(active)
  ruleVersion    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthTarget   HealthTarget @relation(fields: [healthTargetId], references: [id], onDelete: Cascade)
  tasks          PlanTask[]

  @@index([userId, status])
}

model PlanTask {
  id           String         @id @default(cuid())
  planId       String
  scheduledFor DateTime       @db.Date
  actionType   PlanTaskAction
  status       PlanTaskStatus @default(pending)
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  plan         PersonalPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, scheduledFor, actionType])
  @@index([planId, scheduledFor])
}

model WeightRecord {
  id               String         @id @default(cuid())
  userId           String
  valueKg          Float
  recordedAt       DateTime
  note             String?
  isCurrent        Boolean        @default(true)
  previousRecordId String?
  supersededAt     DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  previousRecord   WeightRecord?  @relation("WeightRecordVersions", fields: [previousRecordId], references: [id])
  replacements     WeightRecord[] @relation("WeightRecordVersions")

  @@index([userId, isCurrent, recordedAt])
}

model MealStructureRecord {
  id               String                @id @default(cuid())
  userId           String
  mealType         MealType
  hasStaple        Boolean
  hasProtein       Boolean
  hasVegetable     Boolean
  recordedAt       DateTime
  note             String?
  isCurrent        Boolean               @default(true)
  previousRecordId String?
  supersededAt     DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  previousRecord   MealStructureRecord?  @relation("MealStructureRecordVersions", fields: [previousRecordId], references: [id])
  replacements     MealStructureRecord[] @relation("MealStructureRecordVersions")

  @@index([userId, isCurrent, recordedAt])
}

model ActivityRecord {
  id               String           @id @default(cuid())
  userId           String
  activityType     String
  durationMinutes  Int
  intensity        String?
  recordedAt       DateTime
  note             String?
  isCurrent        Boolean          @default(true)
  previousRecordId String?
  supersededAt     DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  previousRecord   ActivityRecord?  @relation("ActivityRecordVersions", fields: [previousRecordId], references: [id])
  replacements     ActivityRecord[] @relation("ActivityRecordVersions")

  @@index([userId, isCurrent, recordedAt])
}

model SleepRecord {
  id               String        @id @default(cuid())
  userId           String
  durationMinutes  Int
  quality          SleepQuality
  sleepAt          DateTime?
  wakeAt           DateTime?
  recordedAt       DateTime
  note             String?
  isCurrent        Boolean       @default(true)
  previousRecordId String?
  supersededAt     DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  previousRecord   SleepRecord?  @relation("SleepRecordVersions", fields: [previousRecordId], references: [id])
  replacements     SleepRecord[] @relation("SleepRecordVersions")

  @@index([userId, isCurrent, recordedAt])
}

enum IdentityProvider {
  wechat
}

enum ProfileSex {
  female
  male
  unspecified
}

enum HealthGoal {
  weight_management
  weight_maintenance
  muscle_gain
  sleep
  energy
  mood
}

enum AiSafetyDecision {
  allow
  block
}

enum PlanKind {
  weight
  sleep
}

enum PlanStatus {
  active
  paused
  archived
}

enum WeightDirection {
  lose
  maintain
  gain
}

enum PlanTaskAction {
  record_weight
  record_meal
  walk_15_minutes
  record_sleep
}

enum PlanTaskStatus {
  pending
  completed
  skipped
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

enum MealEntrySource {
  manual
  photo_confirmed
}

enum FoodRecognitionJobStatus {
  queued
  processing
  succeeded
  failed
  confirmed
}

enum FoodRecognitionUploadStatus {
  pending
  ready
  expired
}

enum SleepQuality {
  poor
  fair
  good
}
