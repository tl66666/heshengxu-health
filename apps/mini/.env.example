# This value becomes part of the Mini Program build. It is safe only for a public HTTPS API URL.
# Local development can leave this file absent and uses http://localhost:3000/api/v1 automatically.
# VITE_MINI_API_BASE_URL=https://api.example.com/api/v1
# Production builds load original-quality bitmap artwork from this HTTPS origin.
# Upload dist/mini-assets first and keep the /static directory structure unchanged.
# VITE_MINI_ASSET_BASE_URL=https://assets.example.com/heban
# VITE_WECHAT_APP_ID=replace-with-wechat-app-id
