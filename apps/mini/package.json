{
  "name": "@heban/mini",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev:mp-weixin": "node ../../scripts/sync-illustrations.mjs",
    "dev:mp-weixin": "uni -p mp-weixin",
    "clean:dist": "node ../../scripts/clean-mini-dist.mjs",
    "prebuild:mp-weixin": "node ../../scripts/sync-illustrations.mjs",
    "build:mp-weixin": "uni build -p mp-weixin && node ../../scripts/finalize-mini-build.mjs dist/build/mp-weixin",
    "build:mp-weixin:local": "uni build -p mp-weixin",
    "build:mp-weixin:check": "uni build -p mp-weixin && node ../../scripts/finalize-mini-build.mjs dist/build/mp-weixin && node ../../scripts/verify-mini-build.mjs",
    "export:assets": "node ../../scripts/export-mini-assets.mjs",
    "check:layout": "node ../../scripts/verify-repository-layout.mjs",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "^3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "typescript": "5.9.3",
    "vite": "5.2.8",
    "vitest": "2.1.9",
    "vue": "3.4.21",
    "vue-tsc": "3.3.11"
  }
}
